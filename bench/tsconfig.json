{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "paths": {
      "*": [
        "../github_issue/node_modules/*",
        "../github_issue/*"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "jobs"
  ]
}
