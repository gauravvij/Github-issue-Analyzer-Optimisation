# Secrets — these hold live OPENAI_API_KEY / GITHUB_TOKEN values
.env
**/.env

# Dependencies. Real dependency directories only — the trailing slash matters.
# bench/, verification_bench/ and the repo root each track a node_modules SYMLINK
# pointing at github_issue/node_modules, so a git worktree of an older commit
# resolves its imports upward without a second install. Those are versioned.
node_modules/

# Runtime trace output (regenerated on every run; RESULTS.md explicitly
# classes these as generated artifacts, not implementation)
.traces/
**/.traces/

# Preserved upstream clone: carries its own .git, so keeping it here would
# nest a repository. Its identity is pinned by .upstream-snapshot.sha256 and
# .upstream-snapshot.PROVENANCE, and the artifact that matters — the proven
# baseline reconstruction — is the first commit of this repository.
.upstream-snapshot/

# git worktrees for scoring historical versions (see README)
.worktrees/

# Harness self-check output. verify-all.ts regenerates this on every run, so
# tracking it makes a clean gate look like a dirty tree. bench/README.md: job
# directories starting with "_" are self-checks, not measurements.
bench/jobs/_offline-verify/
verification_bench/jobs/_offline-verify/
