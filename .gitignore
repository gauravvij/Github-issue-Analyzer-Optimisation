# Secrets — these hold live OPENAI_API_KEY / GITHUB_TOKEN values
.env
**/.env

# Dependencies
node_modules/

# Runtime trace output (regenerated on every run; RESULTS.md explicitly
# classes these as generated artifacts, not implementation)
.traces/
**/.traces/

# Preserved upstream clone: carries its own .git, so keeping it here would
# nest a repository. Its identity is pinned by .upstream-snapshot.sha256 and
# .upstream-snapshot.PROVENANCE, and the artifact that matters — the proven
# baseline reconstruction — is the first commit of this repository.
.upstream-snapshot/

# git worktrees for scoring historical versions (see README)
.worktrees/
